<script>
  // Play / Pause Micro-Interaction
  let isPlaying = true;
  const playBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-pause-icon');
  
  if (playBtn && playIcon) {
    playBtn.addEventListener('click', () => {
      isPlaying = !isPlaying;
      playIcon.innerText = isPlaying ? 'pause' : 'play_arrow';
    });
  }

  // Bookmark Toggle
  const likeBtn = document.getElementById('like-btn');
  const likeIcon = document.getElementById('like-icon');
  let isSaved = true;

  if (likeBtn && likeIcon) {
    likeBtn.addEventListener('click', () => {
      isSaved = !isSaved;
      likeIcon.innerText = isSaved ? 'bookmark_added' : 'bookmark_border';
    });
  }

  // Reaction Burst Pop Interaction
  function triggerBurst(buttonEl, emoji) {
    const counter = buttonEl.querySelector('.reaction-count');
    if (counter) {
      let countText = counter.innerText.replace('K', '');
      let currentVal = parseFloat(countText);
      counter.innerText = (currentVal + 0.1).toFixed(1) + 'K';
    }
    
    // Quick pop feedback
    buttonEl.classList.add('scale-110');
    setTimeout(() => {
      buttonEl.classList.remove('scale-110');
    }, 150);
  }

  // DSP Quick Knob Tweaker
  function adjustKnob(elementId, step) {
    const el = document.getElementById(elementId);
    if (!el) return;
    if (elementId === 'bass-val') {
      let current = parseInt(el.innerText) || 8;
      let next = current >= 14 ? 2 : current + step;
      el.innerText = '+' + next + 'dB';
    } else {
      let current = parseInt(el.innerText) || 90;
      let next = current >= 99 ? 75 : current + step;
      el.innerText = next + '%';
    }
  }

  // Scrubber interactive touch/click drag
  const scrubberWrap = document.getElementById('scrubber-wrapper');
  const scrubberFill = document.getElementById('scrubber-fill');
  const scrubberPip = document.getElementById('scrubber-pip');
  const currTimeEl = document.getElementById('curr-time');

  if (scrubberWrap && scrubberFill && scrubberPip) {
    const updateScrub = (clientX) => {
      const rect = scrubberWrap.getBoundingClientRect();
      const pos = Math.max(0, Math.min(clientX - rect.left, rect.width));
      const percentage = (pos / rect.width) * 100;
      
      scrubberFill.style.width = percentage + '%';
      scrubberPip.style.left = percentage + '%';

      // Total seconds: 222 (3:42)
      const currentSeconds = Math.floor((percentage / 100) * 222);
      const mins = Math.floor(currentSeconds / 60);
      const secs = currentSeconds % 60;
      if (currTimeEl) {
        currTimeEl.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      }
    };

    scrubberWrap.addEventListener('click', (e) => updateScrub(e.clientX));

    let isDragging = false;
    scrubberPip.addEventListener('pointerdown', (e) => {
      isDragging = true;
      scrubberPip.setPointerCapture(e.pointerId);
    });

    window.addEventListener('pointermove', (e) => {
      if (isDragging) updateScrub(e.clientX);
    });

    window.addEventListener('pointerup', () => {
      isDragging = false;
    });
  }
</script></main></body></html>